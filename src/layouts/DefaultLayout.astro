---
import type { ImageMetadata } from "astro";
import BgLight from "../components/layout/BgLight.astro";
import SiteNav from "../components/navigation/SiteNav.svelte";
import SiteFooter from "../components/footer/SiteFooter.astro";
import ScrollUpButton from "../components/ui/ScrollUpButton.svelte";
import { ClientRouter, slide } from "astro:transitions";
import "../styles/global.css";
import Analytics from "@vercel/analytics/astro";
import fallbackOgImage from "../assets/home/me.webp";

type SeoProps = {
	title: string;
	description: string;
	pathname?: string;
	canonical?: string;
	ogType?: "website" | "article";
	ogImage?: ImageMetadata | string;
	ogImageAlt?: string;
	home?: boolean;
};

const {
	title,
	description,
	pathname,
	canonical,
	ogType,
	ogImage,
	ogImageAlt,
	home = false,
} = Astro.props as SeoProps;

if (!canonical && !pathname) {
	throw new Error(
		"DefaultLayout requires `pathname` unless an explicit `canonical` URL is provided.",
	);
}

if (!Astro.site && !canonical) {
	throw new Error(
		"DefaultLayout requires `Astro.site` to build canonical URLs when `canonical` is not provided.",
	);
}

const resolvedCanonical = canonical ?? new URL(pathname!, Astro.site).toString();
const resolvedOgType =
	ogType ??
	(pathname?.startsWith("/projects/") && pathname !== "/projects" ? "article" : "website");
const resolvedOgImage = ogImage ?? fallbackOgImage;
const resolvedOgImageSrc =
	typeof resolvedOgImage === "string" ? resolvedOgImage : resolvedOgImage.src;
const resolvedOgImageUrl = new URL(resolvedOgImageSrc, Astro.site ?? Astro.url).toString();
const resolvedOgImageAlt = ogImageAlt ?? "Portrait of Leo Zhou";
---

<html
	lang="en"
	transition:animate="none">
	<head>
		<meta charset="utf-8" />
		<link
			rel="apple-touch-icon"
			sizes="180x180"
			href="/apple-touch-icon.png"
		/>
		<link
			rel="icon"
			type="image/png"
			sizes="32x32"
			href="/favicon-32x32.png"
		/>
		<link
			rel="icon"
			type="image/png"
			sizes="16x16"
			href="/favicon-16x16.png"
		/>
		<link
			rel="icon"
			href="/favicon.ico"
		/>
		<link
			rel="manifest"
			href="/site.webmanifest"
		/>
		<link
			rel="preload"
			href="/fonts/LeoHandwriting-Regular.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<meta
			name="viewport"
			content="width=device-width"
		/>
		<meta
			name="generator"
			content={Astro.generator}
		/>
		<title>{title}</title>
		<meta
			name="description"
			content={description}
		/>
		<link
			rel="canonical"
			href={resolvedCanonical}
		/>
		<meta
			property="og:title"
			content={title}
		/>
		<meta
			property="og:description"
			content={description}
		/>
		<meta
			property="og:url"
			content={resolvedCanonical}
		/>
		<meta
			property="og:type"
			content={resolvedOgType}
		/>
		<meta
			property="og:site_name"
			content="Leo Zhou"
		/>
		<meta
			property="og:image"
			content={resolvedOgImageUrl}
		/>
		<meta
			property="og:image:alt"
			content={resolvedOgImageAlt}
		/>
		<meta
			name="twitter:card"
			content="summary_large_image"
		/>
		<meta
			name="twitter:title"
			content={title}
		/>
		<meta
			name="twitter:description"
			content={description}
		/>
		<meta
			name="twitter:image"
			content={resolvedOgImageUrl}
		/>
		<ClientRouter />
	</head>

	<body>
		<Analytics />
		<BgLight>
			<SiteNav
				client:load
				home={home}
			/>
			<main
				class:list={[
					"mx-(--page-gutter) flex min-h-svh min-w-0 flex-1 flex-col",
					home ? "pt-0" : "pt-(--nav-offset)",
				]}
				transition:animate={slide({ duration: "0.35s" })}>
				<slot />
			</main>
			<ScrollUpButton client:load />
			<SiteFooter />
		</BgLight>

		<script is:inline>
			const routeOrderByPath = {
				"/": 0,
				"/projects": 1,
				"/projects/sprout": 2,
				"/about": 3,
				"/contact": 4,
			};

			const getRouteOrderIndex = (pathnameOrUrl) => {
				const pathValue = pathnameOrUrl ? String(pathnameOrUrl) : "/";
				const normalizedPathname =
					pathValue.length > 1 && pathValue.endsWith("/") ? pathValue.slice(0, -1) : pathValue;
				const matchedPath = normalizedPathname.startsWith("/projects/")
					? "/projects/sprout"
					: normalizedPathname;
				return routeOrderByPath[matchedPath];
			};

			if (!window.__siteOrderTransitionsReady) {
				window.__siteOrderTransitionsReady = true;

				document.addEventListener("astro:before-preparation", (event) => {
					const fromRouteOrderIndex = getRouteOrderIndex(
						event.from?.url?.pathname ?? event.from?.pathname,
					);
					const toRouteOrderIndex = getRouteOrderIndex(
						event.to?.url?.pathname ?? event.to?.pathname,
					);

					if (
						fromRouteOrderIndex === undefined ||
						toRouteOrderIndex === undefined ||
						fromRouteOrderIndex === toRouteOrderIndex
					) {
						return;
					}

					event.direction = toRouteOrderIndex > fromRouteOrderIndex ? "forward" : "back";
				});
			}
		</script>
	</body>
</html>
