---
import ObfuscatedEmailRuntime from "../components/contact/ObfuscatedEmailRuntime.astro";
import ImperfectButton from "../components/home/ImperfectButton.astro";
import DefaultLayout from "../layouts/DefaultLayout.astro";
import { encodeEmailHref } from "../utils/obfuscatedEmail";

type ContactLink = {
	label: string;
	href: string;
	fill: string;
	target: string | undefined;
	rel: string | undefined;
};

const contactEmail = import.meta.env.PUBLIC_CONTACT_EMAIL;
const linkedInUrl = import.meta.env.PUBLIC_LINKEDIN_URL;
const githubUrl = import.meta.env.PUBLIC_GITHUB_URL;

const encodedEmailHref = contactEmail ? encodeEmailHref(contactEmail) : undefined;

const contactLinks: ContactLink[] = [
	...(linkedInUrl
		? [
				{
					label: "LinkedIn",
					href: linkedInUrl,
					fill: "var(--color-home-button-sky)",
					target: "_blank",
					rel: "noreferrer",
				},
			]
		: []),
	{
		label: "Resume",
		href: "/resume.pdf",
		fill: "var(--color-button-resume)",
		target: "_blank",
		rel: "noreferrer",
	},
	...(githubUrl
		? [
				{
					label: "GitHub",
					href: githubUrl,
					fill: "var(--color-button-github)",
					target: "_blank",
					rel: "noreferrer",
				},
			]
		: []),
];
---

<DefaultLayout
	title="Contact Leo Zhou | Front End Engineer & UX Designer"
	description="Get in touch with Leo Zhou for frontend development, UX design, and portfolio enquiries. Find email, LinkedIn, GitHub, and resume links here."
	pathname="/contact">
	<ObfuscatedEmailRuntime />
	<section class="contact-page">
		<h1 class="text-hand-display-md m-0 mb-3 text-center font-bold">Get in touch</h1>
		<div class="contact-actions mx-auto mt-10 flex w-full max-w-80 flex-col items-center gap-4">
			{
				contactEmail ? (
					<div class="contact-link-reveal w-full max-w-80">
						<ImperfectButton
							href="#"
							class="imperfect-button--full"
							fill="var(--color-home-button-yellow)"
							data-email-link="true"
							data-email-entities={encodedEmailHref}>
							Email
						</ImperfectButton>
					</div>
				) : null
			}
			{
				contactLinks.map((link) => (
					<div class="contact-link-reveal w-full max-w-80">
						<ImperfectButton
							href={link.href}
							class="imperfect-button--full"
							fill={link.fill}
							target={link.target}
							rel={link.rel}>
							{link.label}
						</ImperfectButton>
					</div>
				))
			}
		</div>
		<p
			class="contact-thanks contact-thanks-reveal font-hand text-hand-title-sm text-handwriting mx-auto mt-8 text-center text-balance">
			Thanks for visiting my website :)
		</p>
	</section>
</DefaultLayout>

<script>
	import "../animation/contactAnimations.ts";
</script>
