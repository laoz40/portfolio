---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import DefaultLayout from "../layouts/DefaultLayout.astro";
import ImperfectButton from "../components/home/ImperfectButton.astro";
import HighlightText from "../components/ui/HighlightText.astro";
import ProjectCardFrame from "../components/projects/ProjectCardFrame.astro";
import { getEntry } from "astro:content";

type ProjectFrontmatter = {
	title: string;
	project: string;
	description: string;
	coverImage?: ImageMetadata;
	altText?: string;
};

const projectSlugs = ["horus", "vvstudios", "sprout", "checkit"] as const;
type ProjectCollection = "horus" | "vvstudios" | "sprout" | "checkit";

const projectCollections = {
	horus: "horus",
	vvstudios: "vvstudios",
	sprout: "sprout",
	checkit: "checkit",
} as const satisfies Record<(typeof projectSlugs)[number], ProjectCollection>;
const projectEntries = await Promise.all(
	projectSlugs.map(async (slug) => ({
		slug,
		entry: await getEntry(projectCollections[slug], "00-intro"),
	})),
);

const missingProjects = projectEntries.filter(({ entry }) => !entry).map(({ slug }) => slug);

if (missingProjects.length > 0) {
	throw new Error(`Missing intro entry for: ${missingProjects.join(", ")}`);
}

const projects: Array<{
	slug: (typeof projectSlugs)[number];
	frontmatter: ProjectFrontmatter;
}> = projectEntries.map(({ slug, entry }) => ({
	slug,
	frontmatter: entry!.data as ProjectFrontmatter,
}));
---

<DefaultLayout
	title="Projects Portfolio | Leo Zhou"
	description="Browse Leo Zhou's frontend and UX case studies, including product design, web app development, and website redesign projects."
	pathname="/projects">
	<section class="projects-page">
		<h1 class="text-hand-display-md m-0 mb-10 text-center font-bold">
			<span class="projects-heading-reveal inline-block">My projects</span>
		</h1>
		<div
			class="projects-layout grid grid-cols-[repeat(2,minmax(0,29.75rem))] justify-center gap-x-12 gap-y-8 max-[900px]:grid-cols-[minmax(0,1fr)] max-[900px]:justify-stretch max-[900px]:gap-7 min-[1440px]:grid-cols-[repeat(2,minmax(0,42.5rem))] min-[1440px]:gap-x-10">
			{
				projects.map(({ slug, frontmatter }) => {
					const cardContent = (
						<ProjectCardFrame class="project-frame--grid">
							<div
								class="preview flex aspect-video w-full items-center justify-center overflow-hidden bg-[rgb(249_245_236)] text-center"
								aria-hidden="true">
								{frontmatter.coverImage ? (
									<Image
										class="preview-image block h-full w-full object-contain"
										src={frontmatter.coverImage}
										alt={frontmatter.altText ?? ""}
										loading="lazy"
										decoding="async"
									/>
								) : (
									<span class="preview-placeholder font-hand text-[3rem] font-bold">
										COMING SOON
									</span>
								)}
							</div>
							<div class="project-meta flex flex-1 flex-col justify-between px-0 pt-4 pb-[0.1rem] min-[1440px]:gap-4">
								<div class="flex flex-col gap-[0.7rem]">
									<div class="project-title flex flex-col items-start gap-[0.35rem]">
										<HighlightText
											tag="h2"
											variant="yellow"
											class="project-title-highlight font-hand text-hand-title-md text-handwriting m-0 leading-[0.5] font-bold [--highlight-bottom:-0.1em] [--highlight-color:var(--color-highlight-yellow-strong)] [--highlight-left:-0.04em] [--highlight-right:-0.03em] [--highlight-top:-0.1em]">
											{frontmatter.title}
										</HighlightText>
										<span class="project-subtitle font-hand text-muted text-[length:var(--type-hand-size-label)] leading-none font-bold tracking-[0.02em]">
											{frontmatter.project}
										</span>
									</div>
									<p class="font-body text-muted m-0 text-base leading-[1.45] max-sm:text-[0.95rem]">
										{frontmatter.description}
									</p>
								</div>
							</div>
						</ProjectCardFrame>
					);

					return (
						<a
							class="project-card project-card-reveal group text-body flex w-full flex-col no-underline odd:[--preview-tilt:-0.45deg] even:[--preview-tilt:0.45deg] max-[900px]:w-full"
							href={`/projects/${slug}`}
							aria-label={`Open ${frontmatter.title} project page`}>
							{cardContent}
						</a>
					);
				})
			}
		</div>
		<div class="projects-cta-reveal mt-10 flex justify-center">
			<ImperfectButton
				href="/about"
				fill="var(--color-home-button-sky)">
				Read about me
			</ImperfectButton>
		</div>
	</section>
</DefaultLayout>

<script>
	import "../animation/projectsAnimations.ts";
</script>
