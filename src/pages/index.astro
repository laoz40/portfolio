---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import DefaultLayout from "../layouts/DefaultLayout.astro";
import HeroSketchCluster from "../components/home/HeroSketchCluster.astro";
import HeroLogoCluster from "../components/home/HeroLogoCluster.astro";
import ImperfectButton from "../components/home/ImperfectButton.astro";
import HighlightText from "../components/ui/HighlightText.astro";
import ProjectCardFrame from "../components/projects/ProjectCardFrame.astro";
import { getEntry } from "astro:content";

type ProjectFrontmatter = {
	title: string;
	project: string;
	description: string;
	coverImage?: ImageMetadata;
};

const vvstudiosEntry = await getEntry("vvstudios", "00-intro");

if (!vvstudiosEntry) {
	throw new Error("Missing intro entry for: vvstudios");
}

const vvstudios = vvstudiosEntry.data as ProjectFrontmatter;
const heroTitle = "Welcome to Leo's Website!";
const heroTitleLines = ["Welcome to", "Leo's Website!"];
---

<DefaultLayout
	title="Front End Engineer & UX Designer Portfolio | Leo Zhou"
	description="Explore Leo Zhou's portfolio of full stack development and UX design work, including web apps and product design case studies."
	pathname="/"
	home>
	<section
		id="hero"
		class="max-nav:min-h-[calc(100svh-8rem)] max-nav:justify-start max-nav:px-4 max-nav:pt-64 max-nav:pb-24 relative flex min-h-[82svh] w-full flex-col items-center justify-center gap-4 px-8 pt-0 pb-22 max-[1100px]:gap-3 max-[1100px]:px-6 max-[1100px]:pt-12 max-[1100px]:pb-24 max-sm:gap-2 max-sm:pt-72">
		<HeroSketchCluster />
		<HeroLogoCluster />

		<div
			class="hero-copy max-nav:max-w-96 relative z-2 flex w-full max-w-216 flex-col items-center gap-4 max-[1100px]:max-w-136 max-sm:max-w-80 max-sm:gap-[0.9rem]">
			<h1
				class="hero-title text-hand-display-lg m-0 max-w-[12ch] text-center leading-[0.96] font-bold tracking-[-0.04em] text-balance max-sm:max-w-[10ch]"
				aria-label={heroTitle}>
				{
					heroTitleLines.map((line) => (
						<span class="hero-title-line relative mx-auto flex w-fit flex-col items-center overflow-hidden [&+&]:mt-[0.08em]">
							<span
								class="hero-title-text inline-block"
								aria-hidden="true">
								{line}
							</span>
						</span>
					))
				}
			</h1>

			<div class="hero-roles flex flex-col items-center gap-[0.35rem] max-sm:gap-[0.2rem]">
				<h2
					class="text-hand-display-sm m-0 text-center leading-[1.05] tracking-[-0.02em] text-balance max-sm:max-w-[15ch]">
					Full Stack Developer
				</h2>
				<h2
					class="text-hand-display-sm m-0 text-center leading-[1.05] tracking-[-0.02em] text-balance max-sm:max-w-[15ch]">
					UX Designer
				</h2>
			</div>
		</div>

		<div
			class="hero-actions max-nav:mt-1 relative z-2 mt-4 flex flex-wrap items-center justify-center gap-6 max-[1100px]:mt-2 max-[420px]:max-w-60 max-[420px]:grid-cols-1 max-sm:mt-2 max-sm:mb-15 max-sm:grid max-sm:w-full max-sm:max-w-84 max-sm:grid-cols-2 max-sm:gap-0">
			<ImperfectButton
				href="/projects"
				class="imperfect-button--compact"
				fill="var(--color-home-button-yellow)">
				Projects
			</ImperfectButton>
			<ImperfectButton
				href="/about"
				class="imperfect-button--compact"
				fill="var(--color-home-button-sky)">
				About
			</ImperfectButton>
		</div>

		<div
			class="hero-footer max-nav:max-w-136 absolute bottom-6 left-1/2 z-2 flex w-[calc(100%-2rem)] max-w-176 -translate-x-1/2 flex-col items-center gap-2 max-[1100px]:bottom-5 max-sm:bottom-5 max-sm:w-[calc(100%-1.5rem)] max-sm:max-w-88 max-sm:gap-2">
			<p
				class="hero-note font-hand text-hand-body text-handwriting m-0 text-center max-sm:text-base max-sm:text-balance">
				This website wasn't hand-coded or vibe-coded. It was all hand-drawn.
			</p>
		</div>
	</section>

	<section
		id="featured"
		class="flex min-h-svh flex-col items-center gap-8 pt-6 max-sm:pt-4">
		<a
			class="project-card group featured-project-card-reveal text-body flex w-full max-w-[70rem] no-underline"
			href="/projects/vvstudios"
			aria-label={`Open ${vvstudios.title} project page`}>
			<ProjectCardFrame class="project-frame--featured">
				<div
					class="preview aspect-video min-h-[17.25rem] w-full overflow-hidden bg-[rgb(249_245_236)] max-sm:min-h-auto"
					aria-hidden="true">
					{
						vvstudios.coverImage ? (
							<Image
								class="preview-image block h-full w-full object-cover"
								src={vvstudios.coverImage}
								alt=""
								loading="eager"
								fetchpriority="high"
								decoding="async"
							/>
						) : null
					}
				</div>
				<div class="project-meta px-0 pt-4 pb-[0.1rem]">
					<div class="flex flex-col gap-[0.7rem]">
						<div class="project-title flex flex-col items-start gap-[0.35rem]">
							<HighlightText
								tag="h4"
								variant="yellow"
								class="project-title-highlight font-hand text-hand-title-md text-handwriting m-0 leading-[0.5] font-bold [--highlight-bottom:-0.1em] [--highlight-color:var(--color-highlight-yellow-strong)] [--highlight-left:-0.04em] [--highlight-right:-0.03em] [--highlight-top:-0.1em]">
								{vvstudios.title}
							</HighlightText>
							<span
								class="project-subtitle font-hand text-muted text-[length:var(--type-hand-size-label)] font-bold tracking-[0.02em]">
								{vvstudios.project}
							</span>
						</div>
						<p class="font-body text-muted m-0 text-base leading-[1.45] max-sm:text-[0.95rem]">
							{vvstudios.description}
						</p>
					</div>
				</div>
			</ProjectCardFrame>
		</a>
		<div class="featured-projects-cta-reveal flex w-full justify-center">
			<ImperfectButton
				href="/projects"
				fill="var(--color-home-button-yellow)">
				See more projects
			</ImperfectButton>
		</div>
	</section>
</DefaultLayout>

<script>
	import "../animation/heroAnimations.ts";
</script>
