---
import { createContentSection } from "../../components/projects/caseStudySections";
import DefaultLayout from "../../layouts/DefaultLayout.astro";
import ProjectCaseStudy from "../../components/projects/ProjectCaseStudy.astro";
import Intro from "../../content/vv-podcast-studio/00-intro.md";
import ProjectOverview from "../../content/vv-podcast-studio/01-project-overview.md";
import KeyImprovements from "../../content/vv-podcast-studio/02-key-improvements.md";

const [introResult, projectOverviewResult, keyImprovementsResult] = await Promise.all([
	createContentSection({
		collection: "vvPodcastStudio",
		entryId: "00-intro",
		Component: Intro,
	}),
	createContentSection({
		collection: "vvPodcastStudio",
		entryId: "01-project-overview",
		Component: ProjectOverview,
	}),
	createContentSection({
		collection: "vvPodcastStudio",
		entryId: "02-key-improvements",
		Component: KeyImprovements,
	}),
]);

const { frontmatter: introFrontmatter, section: introSection } = introResult;
const { section: projectOverviewSection } = projectOverviewResult;
const { section: keyImprovementsSection } = keyImprovementsResult;

const sections = [introSection, projectOverviewSection, keyImprovementsSection];
---

<DefaultLayout
	title="VV Podcast Studio Website Redesign Case Study | Leo Zhou"
	description="Review Leo Zhou's VV Podcast Studio case study covering a custom website rebuild, UX improvements, and workflow automations for the business."
	pathname="/projects/vv-podcast-studio"
	ogType="article"
	ogImage={introFrontmatter.coverImage}
	ogImageAlt={introFrontmatter.altText ?? introFrontmatter.section?.media?.alt}>
	<ProjectCaseStudy sections={sections} />
</DefaultLayout>
