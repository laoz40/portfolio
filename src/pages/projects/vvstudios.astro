---
import {
	createContentSection,
	getImageMediaAlt,
} from "../../components/projects/caseStudySections";
import DefaultLayout from "../../layouts/DefaultLayout.astro";
import ProjectCaseStudy from "../../components/projects/ProjectCaseStudy.astro";
import Intro from "../../content/vvstudios/00-intro.md";
import ProjectOverview from "../../content/vvstudios/01-project-overview.md";
import ProjectShowcase from "../../content/vvstudios/02-project-showcase.md";
import PreviousWebsite from "../../content/vvstudios/03-previous-website.md";
import KeyImprovements from "../../content/vvstudios/04-key-improvements.md";

const [
	introResult,
	projectOverviewResult,
	projectShowcaseResult,
	previousWebsiteResult,
	keyImprovementsResult,
] = await Promise.all([
	createContentSection({
		collection: "vvstudios",
		entryId: "00-intro",
		Component: Intro,
	}),
	createContentSection({
		collection: "vvstudios",
		entryId: "01-project-overview",
		Component: ProjectOverview,
	}),
	createContentSection({
		collection: "vvstudios",
		entryId: "02-project-showcase",
		Component: ProjectShowcase,
	}),
	createContentSection({
		collection: "vvstudios",
		entryId: "03-previous-website",
		Component: PreviousWebsite,
	}),
	createContentSection({
		collection: "vvstudios",
		entryId: "04-key-improvements",
		Component: KeyImprovements,
	}),
]);

const { frontmatter: introFrontmatter, section: introSection } = introResult;
const { section: projectOverviewSection } = projectOverviewResult;
const { section: projectShowcaseSection } = projectShowcaseResult;
const { section: previousWebsiteSection } = previousWebsiteResult;
const { section: keyImprovementsSection } = keyImprovementsResult;

const sections = [
	introSection,
	projectOverviewSection,
	projectShowcaseSection,
	previousWebsiteSection,
	keyImprovementsSection,
];
---

<DefaultLayout
	title="VV Studios Website Rebuild Case Study | Leo Zhou"
	description="Review Leo Zhou's VV Studios case study covering a custom website rebuild, UX improvements, and workflow automations for the business."
	pathname="/projects/vvstudios"
	ogType="article"
	ogImage={introFrontmatter.coverImage}
	ogImageAlt={introFrontmatter.altText ?? getImageMediaAlt(introFrontmatter.section?.media)}>
	<ProjectCaseStudy sections={sections} />
</DefaultLayout>
