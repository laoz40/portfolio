---
import { getCollection, render } from "astro:content";
import AboutSectionMedia from "../components/about/AboutSectionMedia.astro";
import ImperfectButton from "../components/home/ImperfectButton.astro";
import DefaultLayout from "../layouts/DefaultLayout.astro";
import type { ContentFrontmatter } from "../components/projects/caseStudySections";

type AboutImageMedia = Extract<
	NonNullable<ContentFrontmatter["section"]>["media"],
	{ type: "image" }
>;

const aboutEntries = (await getCollection("about")).sort((a, b) => a.id.localeCompare(b.id));

const aboutSections = await Promise.all(
	aboutEntries.map(async (entry) => {
		const { Content } = await render(entry);
		const data = entry.data as ContentFrontmatter;
		const media = data.section?.media;

		if (media && media.type !== "image") {
			throw new Error(`About entry ${entry.id} uses unsupported media type: ${media.type}`);
		}

		return {
			id: entry.id,
			title: data.title ?? entry.id,
			Content,
			media: media as AboutImageMedia | undefined,
		};
	}),
);
---

<DefaultLayout
	title="About Leo Zhou | Front End Engineer & UX Designer"
	description="Learn about Leo Zhou's background in frontend development, UX design, and the process behind his work across web and interface design."
	pathname="/about">
	<section class="about-page">
		<h1 class="text-hand-display-md m-0 mx-auto mb-6 w-full max-w-312 text-center font-bold">
			A little bit about me
		</h1>
		<article
			class="mx-auto mt-6 grid w-full max-w-312 gap-14 [--about-media-column-width:22rem] [--text-measure:65ch] max-md:gap-10">
			{
				aboutSections.map(({ id, title, Content, media }, index) => (
					<section
						class:list={[
							"grid items-center gap-10 max-md:gap-7",
							media
								? "md:grid-cols-[minmax(0,1fr)_var(--about-media-column-width)] md:[grid-template-areas:'copy_media']"
								: "grid-cols-[minmax(0,1fr)]",
							media && index % 2 === 1
								? "md:grid-cols-[var(--about-media-column-width)_minmax(0,1fr)] md:[grid-template-areas:'media_copy']"
								: undefined,
						]}
						data-about-section={id}>
						<div class="about-section-copy [&_h2]:text-hand-title-lg [&_li]:font-body [&_li]:text-body [&_p]:font-body [&_p]:text-body min-w-0 md:[grid-area:copy] [&_h2]:mb-4 [&_h2]:max-w-[24ch] [&_h2]:leading-none [&_h2]:font-bold [&_h2]:tracking-[0.01em] [&_li]:mb-4 [&_li]:max-w-[var(--text-measure)] [&_li]:leading-[var(--type-sans-leading-compact)] [&_li]:font-light [&_li]:text-pretty [&_p]:mb-4 [&_p]:max-w-[var(--text-measure)] [&_p]:leading-[var(--type-sans-leading-reading)] [&_p]:font-light [&_p]:text-pretty [&_ul]:mb-4 [&_ul]:list-disc [&_ul]:pl-5">
							<h2>{title}</h2>
							<Content />
						</div>
						{media ? (
							<div class="about-section-media flex w-full min-w-0 items-center justify-center max-md:justify-start md:[grid-area:media]">
								<AboutSectionMedia media={media} />
							</div>
						) : null}
					</section>
				))
			}
		</article>
		<div
			class="about-actions-reveal mx-auto mt-10 flex w-full max-w-312 flex-col items-center gap-4 text-center">
			<p
				class="about-actions-note about-actions-note-reveal font-hand text-hand-title-md text-handwriting m-0 font-normal text-balance">
				Thanks for reading all of this! (if you did)
			</p>
			<div class="about-actions-cta-reveal">
				<ImperfectButton
					href="/projects"
					fill="var(--color-home-button-yellow)">
					See my projects
				</ImperfectButton>
			</div>
		</div>
	</section>
</DefaultLayout>

<script>
	import "../animation/aboutAnimations.ts";
</script>
