---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

const { media } = Astro.props as {
	media: {
		image: ImageMetadata;
		alt: string;
		caption?: string;
		variant?: "taped" | "raw";
	};
};

const variant = media.variant ?? "taped";
const isTaped = variant === "taped";
---

<figure
	class:list={[
		"about-media-figure m-0 w-[min(100%,var(--about-media-max-width))] w-full max-md:w-[min(100%,26rem,var(--about-media-max-width))]",
		isTaped ? "pt-[calc(var(--size-project-tape-height)*0.5)]" : undefined,
	]}
	style={`--about-media-max-width: ${media.image.width}px; --about-media-aspect-ratio: ${media.image.width} / ${media.image.height};`}>
	{
		isTaped ? (
			<div
				class="about-media-frame taped-frame relative w-full min-w-0"
				style="--tape-top: calc(var(--size-project-tape-height) * 0.2);">
				<div class="about-media paper-frame relative flex [aspect-ratio:var(--about-media-aspect-ratio)] max-h-96 items-center justify-center overflow-hidden max-md:max-h-88">
					<Image
						class="about-media-image block h-full w-full object-cover object-center"
						src={media.image}
						alt={media.alt}
						width={media.image.width}
						height={media.image.height}
						loading="lazy"
						decoding="async"
					/>
				</div>
			</div>
		) : (
			<Image
				class="about-media-image block h-auto max-h-96 w-auto max-w-full object-contain max-md:max-h-88"
				src={media.image}
				alt={media.alt}
				width={media.image.width}
				height={media.image.height}
				loading="lazy"
				decoding="async"
			/>
		)
	}
	{
		isTaped ? (
			<figcaption class="about-media-caption font-hand text-hand-label mt-3 leading-[1.4]">
				{media.caption ?? media.alt}
			</figcaption>
		) : null
	}
</figure>
