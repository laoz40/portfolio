---
import ObfuscatedEmailRuntime from "../contact/ObfuscatedEmailRuntime.astro";
import NavLink from "../navigation/NavLink.astro";
import { encodeEmailHref } from "../../utils/obfuscatedEmail";

type FooterLink = {
	label: string;
	href: string;
	variant: "lime";
	target: string | undefined;
	rel: string | undefined;
};

const contactEmail = import.meta.env.PUBLIC_CONTACT_EMAIL;
const linkedInUrl = import.meta.env.PUBLIC_LINKEDIN_URL;
const encodedEmailHref = contactEmail ? encodeEmailHref(contactEmail) : undefined;

const footerLinks: FooterLink[] = linkedInUrl
	? [
			{
				label: "LinkedIn",
				href: linkedInUrl,
				variant: "lime",
				target: "_blank",
				rel: "noreferrer",
			},
		]
	: [];
---

<footer
	id="contact"
	aria-label="Social and contact links"
	class="mt-40 grid grid-cols-1 items-start justify-items-center gap-[0.85rem] pb-32"
	data-footer-root
	transition:animate="none">
	<ObfuscatedEmailRuntime />
	<div class="footer-cta-reveal grid justify-items-center gap-[0.2rem] text-balance">
		<a
			class="footer-cta-link font-hand text-handwriting text-hand-title-lg text-center leading-none font-bold no-underline"
			href="/contact">
			If you've scrolled this far, you probably wanted these:
		</a>
	</div>

	<div
		class="footer-links flex flex-wrap items-center justify-center gap-2 max-sm:[&_.nav-link-text]:text-2xl">
		{
			contactEmail ? (
				<div class="footer-link-reveal inline-flex">
					<NavLink
						href="#"
						variant="lime"
						data-email-link="true"
						data-email-entities={encodedEmailHref}>
						Email
					</NavLink>
				</div>
			) : null
		}
		{
			footerLinks.map((link) => (
				<div class="footer-link-reveal inline-flex">
					<NavLink
						href={link.href}
						variant={link.variant}
						target={link.target}
						rel={link.rel}>
						{link.label}
					</NavLink>
				</div>
			))
		}
	</div>

	<div class="flex w-full flex-col items-center justify-center gap-[0.2rem]">
		<p class="footer-copyright footer-copyright-reveal font-hand text-muted m-0">
			<span aria-hidden="true">&copy;</span>
			<span data-current-year>0000</span>
			<span class="footer-copyright-name">Leo Zhou</span>
		</p>
		<p
			class="footer-note footer-note-reveal font-hand text-muted m-4 text-center font-normal text-balance">
			Handwriting typeface created by me. Please don't impersonate me.
		</p>
	</div>
</footer>

<style>
	.footer-copyright {
		display: inline-flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: center;
		gap: 0.35em;
	}
</style>

<script>
	import "../../animation/footerAnimations.ts";
</script>
