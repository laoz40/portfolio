---
type Props = {
	tools: string[];
	projectTitle: string;
};

const { tools, projectTitle } = Astro.props as Props;
---

<div class="tool-badges-shell m-0 p-0">
	<ul
		class="tool-badges m-0 flex list-none flex-wrap gap-2 p-0"
		aria-label={`${projectTitle} tools used`}>
		{
			tools.map((tool) => (
				<li class="tool-badge p-0">
					<span class="tool-badge-shape border-border-soft-token bg-paper font-hand text-hand-label-sm text-handwriting inline-block border px-3 py-px font-bold tracking-wide">
						{tool}
					</span>
				</li>
			))
		}
	</ul>
</div>

<style>
	.tool-badge-shape {
		box-shadow: 1px 2px 3px var(--color-shadow-soft);
	}

	.tool-badge:nth-child(3n + 1) {
		transform: rotate(-0.9deg) translateY(-0.5px);
	}

	.tool-badge:nth-child(3n + 2) {
		transform: rotate(0.65deg) translateY(0.35px);
	}

	.tool-badge:nth-child(3n + 3) {
		transform: rotate(-0.45deg) translateY(0.2px);
	}
</style>
