---
type HighlightVariant = "yellow" | "lime" | "sky";

type Props = {
	tag?: "span" | "h2" | "h4";
	variant?: HighlightVariant;
	selectable?: boolean;
	class?: string;
	style?: string;
};

const {
	tag = "span",
	variant = "yellow",
	selectable = false,
	class: className,
	style,
} = Astro.props as Props;

const variantByName: Record<HighlightVariant, string> = {
	yellow: "var(--color-highlight-yellow)",
	lime: "var(--color-highlight-lime)",
	sky: "var(--color-highlight-sky)",
};

const highlightColor = variantByName[variant] ?? variantByName.yellow;
const Tag = tag;
---

<Tag
	class:list={["highlight-text", className, selectable ? "select-text" : "select-none"]}
	style={[style, `--highlight-color: ${highlightColor};`].filter(Boolean).join(" ")}>
	<slot />
</Tag>
