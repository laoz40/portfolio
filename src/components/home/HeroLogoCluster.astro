---
import { Image } from "astro:assets";
import tsImage from "../../assets/home/ts.webp";
import reactImage from "../../assets/home/react.webp";
import nextjsImage from "../../assets/home/nextjs.webp";
import cssImage from "../../assets/home/css.webp";
import figmaImage from "../../assets/home/figma.webp";
---

<div
	class="hero-logo-cluster hero-image-reveal pointer-events-none absolute inset-0 z-1 select-none"
	aria-hidden="true">
	<p
		class="hero-logo-label font-hand text-muted max-nav:hidden absolute top-34 right-7 m-0 -rotate-1 text-[length:var(--type-hand-size-note)] tracking-[0.01em] opacity-78 max-[980px]:top-23 max-[980px]:right-4 max-[980px]:text-[length:var(--type-hand-size-label-sm)]">
		Stuff I use
	</p>
	<Image
		class="hero-logo hero-logo-ts max-nav:hidden absolute top-44 right-28 h-auto w-26 rotate-6 object-contain opacity-80 contrast-110 saturate-50 max-[980px]:top-37 max-[980px]:right-20 max-[980px]:w-20"
		src={tsImage}
		alt=""
		loading="eager"
		fetchpriority="high"
		decoding="async"
	/>
	<Image
		class="hero-logo hero-logo-react max-nav:top-48 max-nav:right-[4.25rem] max-nav:w-[4.1rem] max-nav:opacity-75 absolute top-100 right-32 h-auto w-26 -rotate-8 object-contain opacity-80 contrast-110 saturate-50 max-[980px]:top-71 max-[980px]:right-25 max-[980px]:w-20 max-sm:top-35 max-sm:right-12 max-sm:w-[3.35rem]"
		src={reactImage}
		alt=""
		loading="eager"
		fetchpriority="high"
		decoding="async"
	/>
	<Image
		class="hero-logo hero-logo-nextjs max-nav:top-32 max-nav:right-2 max-nav:w-[4.4rem] max-nav:opacity-75 absolute top-[19.5rem] right-0 h-auto w-28 rotate-5 object-contain opacity-80 contrast-110 saturate-50 max-[980px]:top-62 max-[980px]:right-3 max-[980px]:w-22 max-sm:top-18 max-sm:right-3.5 max-sm:w-14"
		src={nextjsImage}
		alt=""
		loading="eager"
		fetchpriority="high"
		decoding="async"
	/>
	<Image
		class="hero-logo hero-logo-css max-nav:hidden absolute top-124 right-6 h-auto w-26 -rotate-6 object-contain opacity-80 contrast-110 saturate-50 max-[980px]:top-99 max-[980px]:right-5 max-[980px]:w-20"
		src={cssImage}
		alt=""
		loading="eager"
		fetchpriority="high"
		decoding="async"
	/>
	<Image
		class="hero-logo hero-logo-figma max-nav:top-80 max-nav:right-3.5 max-nav:w-[3.8rem] max-nav:opacity-75 absolute top-[min(39.5rem,calc(100%-8rem))] right-4 h-auto w-[5.75rem] rotate-8 object-contain opacity-80 contrast-110 saturate-50 max-[980px]:top-128 max-[980px]:w-[4.75rem] max-sm:top-55 max-sm:right-4.5 max-sm:w-12"
		src={figmaImage}
		alt=""
		loading="eager"
		fetchpriority="high"
		decoding="async"
	/>
</div>
