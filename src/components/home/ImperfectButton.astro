---
const buttonPath = `M16,10
	C52,8 96,12 140,9
	C168,8 186,11 194,10
	C198,10 200,12 200,16
	L201,52
	C201,56 199,59 194,60
	C156,62 112,58 70,61
	C42,63 24,59 16,60
	C12,60 6,58 6,53
	L5,17
	C5,13 10,10 16,10 Z`;
const {
	fill,
	href,
	target,
	rel,
	class: className,
	...attributes
} = Astro.props as {
	fill: string;
	href?: string;
	target?: string;
	rel?: string;
	class?: string;
	[key: string]: unknown;
};
---

{
	href ? (
		<a
			href={href}
			target={target}
			rel={rel}
			{...attributes}
			class:list={["imperfect-button", className]}
			style={`--fill: ${fill};`}>
			<span>
				<slot />
			</span>

			<svg
				viewBox="0 0 220 70"
				preserveAspectRatio="none"
				aria-hidden="true">
				<path
					d={buttonPath}
					transform="translate(10 0)"
					stroke="none"
					stroke-width="3"
					stroke-linecap="round"
					stroke-linejoin="round"
				/>
			</svg>
		</a>
	) : (
		<button
			type="button"
			{...attributes}
			class:list={["imperfect-button", className]}
			style={`--fill: ${fill};`}>
			<span>
				<slot />
			</span>

			<svg
				viewBox="0 0 220 70"
				preserveAspectRatio="none"
				aria-hidden="true">
				<path
					d={buttonPath}
					transform="translate(10 0)"
					stroke="none"
					stroke-width="3"
					stroke-linecap="round"
					stroke-linejoin="round"
				/>
			</svg>
		</button>
	)
}

<style>
	.imperfect-button {
		position: relative;
		display: inline-grid;
		place-items: center;
		--fill-solid: rgb(from var(--fill) r g b);
		--paper-fill: var(--fill-solid);
		--button-shadow-rest: 3px 4px 2px var(--color-shadow-button-rest);
		--button-shadow-hover: 5px 6px 3px var(--color-shadow-button-hover);
		--button-motion-duration: 0.16s;
		--button-motion-easing: cubic-bezier(0.22, 1, 0.36, 1);
		--button-motion-active-duration: 0.08s;
		--button-motion-active-easing: cubic-bezier(0.3, 0, 0.4, 1);
		padding: 0.9rem 1.6rem;
		border: 0;
		cursor: pointer;
		user-select: none;
		font-family: var(--font-handwriting);
		font-size: var(--type-hand-size-title-md);
		font-weight: 700;
		text-decoration: none;
		transition: transform var(--button-motion-duration) var(--button-motion-easing);
	}

	.imperfect-button span {
		position: relative;
		z-index: 1;
		letter-spacing: 0.2px;
		user-select: none;
	}

	.imperfect-button svg {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		z-index: 0;
		pointer-events: none;
		transition:
			transform var(--button-motion-duration) var(--button-motion-easing),
			filter var(--button-motion-duration) var(--button-motion-easing),
			fill var(--button-motion-duration) var(--button-motion-easing);
		filter: drop-shadow(var(--button-shadow-rest));
		fill: var(--paper-fill);
	}

	.imperfect-button path {
		stroke-width: 3.2;
	}

	.imperfect-button--full {
		width: 100%;
	}

	.imperfect-button--compact {
		@media (max-width: 640px) {
			min-height: 3rem;
			width: 100%;
			padding: 1rem;
			font-size: 1.5rem;
		}
	}

	.imperfect-button--compact span {
		@media (max-width: 640px) {
			line-height: 1.05;
		}
	}

	.imperfect-button--link-grid {
		min-height: 3rem;
		width: 100%;
		padding: 1rem;
		text-align: center;
		font-size: 1.5rem;
		line-height: 1.05;
	}

	.imperfect-button--link-grid span {
		display: inline-block;
		max-width: 10ch;
		text-wrap: balance;
	}

	@media (max-width: 520px) {
		.imperfect-button--link-grid {
			min-height: 4.25rem;
			padding: 0.85rem 1rem;
			font-size: 1.8rem;
		}
	}

	.imperfect-button:hover {
		transform: translate(-2px, -3px) rotate(-0.9deg);
	}

	.imperfect-button:hover svg {
		filter: drop-shadow(var(--button-shadow-hover));
	}

	.imperfect-button:active {
		transition-duration: var(--button-motion-active-duration);
		transition-timing-function: var(--button-motion-active-easing);
		transform: translate(1px, 1px) rotate(-0.15deg);
	}

	.imperfect-button:active svg {
		transition-duration: var(--button-motion-active-duration);
		transition-timing-function: var(--button-motion-active-easing);
		filter: drop-shadow(2px 3px 2px var(--color-shadow-button-active));
	}

	@media (prefers-reduced-motion: reduce) {
		.imperfect-button,
		.imperfect-button svg {
			transition: none;
		}

		.imperfect-button:hover,
		.imperfect-button:active {
			transform: none;
		}
	}
</style>
