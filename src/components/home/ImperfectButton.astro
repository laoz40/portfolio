---
const buttonPath = `M14,11
	C24,11 14,11 84,9
	C120,11 158,8 188,10
	C198,10 200,10 200,21
	L201,43
	C199,58 198,58 191,60
	C159,58 123,63 91,61
	C57,62 28,64 17,61
	C-1,60 7,60 5,38
	L6,23
	C7,17 5,13 14,11 Z`;
type ButtonSize = "default" | "full" | "compact" | "link-grid";

const {
	fill,
	href,
	target,
	rel,
	size = "default",
	class: className,
	...attributes
} = Astro.props as {
	fill: string;
	href?: string;
	target?: string;
	rel?: string;
	size?: ButtonSize;
	class?: string;
	[key: string]: unknown;
};

const buttonClasses = {
	default:
		"imperfect-button font-hand text-hand-title-md relative inline-grid cursor-pointer place-items-center border-0 px-6 py-3.5 font-bold select-none",
	full: "imperfect-button font-hand text-hand-title-md relative inline-grid w-full cursor-pointer place-items-center border-0 px-6 py-3.5 font-bold select-none",
	compact:
		"imperfect-button font-hand text-hand-title-md relative inline-grid cursor-pointer place-items-center border-0 px-6 py-3.5 font-bold select-none max-sm:min-h-12 max-sm:w-full max-sm:p-4 max-sm:text-2xl",
	"link-grid":
		"imperfect-button font-hand relative inline-grid min-h-12 w-full cursor-pointer place-items-center border-0 p-4 text-center text-2xl leading-[1.05] font-bold select-none max-[520px]:min-h-[4.25rem] max-[520px]:px-4 max-[520px]:py-[0.85rem] max-[520px]:text-[1.8rem]",
};

const labelClasses: Record<ButtonSize, string> = {
	default: "relative z-10 select-none",
	full: "relative z-10 select-none",
	compact: "relative z-10 select-none max-sm:leading-[1.05]",
	"link-grid": "relative z-10 inline-block max-w-[10ch] text-balance select-none",
};
---

{
	href ? (
		<a
			href={href}
			target={target}
			rel={rel}
			{...attributes}
			class:list={[buttonClasses[size], className, "no-underline"]}
			style={`--fill: ${fill};`}>
			<span class={labelClasses[size]}>
				<slot />
			</span>

			<svg
				class="imperfect-button-shape pointer-events-none absolute inset-0 z-0 h-full w-full"
				viewBox="0 0 220 70"
				preserveAspectRatio="none"
				aria-hidden="true">
				<path
					d={buttonPath}
					transform="translate(10 0)"
					stroke="none"
					stroke-width="3"
					stroke-linecap="round"
					stroke-linejoin="round"
				/>
			</svg>
		</a>
	) : (
		<button
			type="button"
			{...attributes}
			class:list={[buttonClasses[size], className]}
			style={`--fill: ${fill};`}>
			<span class={labelClasses[size]}>
				<slot />
			</span>

			<svg
				class="imperfect-button-shape pointer-events-none absolute inset-0 z-0 h-full w-full"
				viewBox="0 0 220 70"
				preserveAspectRatio="none"
				aria-hidden="true">
				<path
					d={buttonPath}
					transform="translate(10 0)"
					stroke="none"
					stroke-width="3"
					stroke-linecap="round"
					stroke-linejoin="round"
				/>
			</svg>
		</button>
	)
}

<style>
	.imperfect-button {
		--fill-solid: rgb(from var(--fill) r g b);
		--paper-fill: var(--fill-solid);
		--button-shadow-rest: 3px 4px 2px var(--color-shadow-button-rest);
		--button-shadow-hover: 5px 6px 3px var(--color-shadow-button-hover);
		--button-motion-duration: 0.16s;
		--button-motion-easing: cubic-bezier(0.22, 1, 0.36, 1);
		--button-motion-active-duration: 0.08s;
		--button-motion-active-easing: cubic-bezier(0.3, 0, 0.4, 1);
		letter-spacing: 0.2px;
		transition: transform var(--button-motion-duration) var(--button-motion-easing);
	}

	.imperfect-button-shape {
		transition:
			transform var(--button-motion-duration) var(--button-motion-easing),
			filter var(--button-motion-duration) var(--button-motion-easing),
			fill var(--button-motion-duration) var(--button-motion-easing);
		filter: drop-shadow(var(--button-shadow-rest));
		fill: var(--paper-fill);
	}

	.imperfect-button-shape path {
		stroke-width: 3.2;
	}

	.imperfect-button:hover {
		transform: translate(-2px, -3px) rotate(-0.9deg);
	}

	.imperfect-button:hover .imperfect-button-shape {
		filter: drop-shadow(var(--button-shadow-hover));
	}

	.imperfect-button:active {
		transition-duration: var(--button-motion-active-duration);
		transition-timing-function: var(--button-motion-active-easing);
		transform: translate(1px, 1px) rotate(-0.15deg);
	}

	.imperfect-button:active .imperfect-button-shape {
		transition-duration: var(--button-motion-active-duration);
		transition-timing-function: var(--button-motion-active-easing);
		filter: drop-shadow(2px 3px 2px var(--color-shadow-button-active));
	}

	@media (prefers-reduced-motion: reduce) {
		.imperfect-button,
		.imperfect-button-shape {
			transition: none;
		}

		.imperfect-button:hover,
		.imperfect-button:active {
			transform: none;
		}
	}
</style>
