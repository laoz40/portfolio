---
const { href = "#featured", label = "Scroll to featured section" } = Astro.props;
---

<a
	class="scroll-down text-handwriting inline-flex items-center justify-center leading-none no-underline transition-transform duration-150 hover:-translate-y-1 focus-visible:-translate-y-1 motion-reduce:transition-none motion-reduce:hover:translate-none motion-reduce:focus-visible:translate-none [&_svg]:h-12 [&_svg]:w-12 [&_svg]:drop-shadow-[1px_2px_0_var(--color-shadow-medium)]"
	href={href}
	aria-label={label}>
	<svg
		viewBox="0 0 56 56"
		aria-hidden="true"
		focusable="false">
		<path
			d="M28 8 C27 20, 27 30, 28 42"
			fill="none"
			stroke="currentColor"
			stroke-width="3.2"
			stroke-linecap="round"
		></path>
		<path
			d="M18 34 C22 39, 25 43, 28 48"
			fill="none"
			stroke="currentColor"
			stroke-width="3.2"
			stroke-linecap="round"
		></path>
		<path
			d="M38 34 C34 39, 31 43, 28 48"
			fill="none"
			stroke="currentColor"
			stroke-width="3.2"
			stroke-linecap="round"
		></path>
	</svg>
</a>
