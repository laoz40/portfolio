---
import { Image } from "astro:assets";
import dolphinImage from "../../assets/home/dolphin.webp";
import icecreamImage from "../../assets/home/icecream.webp";
import meImage from "../../assets/home/me.webp";
import penroseImage from "../../assets/home/penrose.webp";
---

<div
	class="hero-art-cluster hero-image-reveal pointer-events-none absolute inset-0 z-1 select-none">
	<Image
		class="hero-portrait max-nav:top-[4.75rem] max-nav:left-[max(0.25rem,env(safe-area-inset-left))] max-nav:max-h-[32svh] max-nav:w-48 absolute top-[6vh] left-0 z-1 max-h-[min(52svh,32rem)] w-72 object-contain object-left-bottom opacity-90 max-[980px]:max-h-[min(46svh,28rem)] max-[980px]:w-60 max-sm:top-[4.5rem] max-sm:max-h-[28svh] max-sm:w-40"
		src={meImage}
		alt="Illustration of Leo"
		loading="eager"
		fetchpriority="high"
		decoding="async"
	/>

	<div
		class="hero-sketch-cluster absolute inset-0 z-0 max-sm:hidden"
		aria-hidden="true">
		<Image
			class="hero-sketch hero-sketch-dolphin max-nav:top-100 max-nav:left-3 max-nav:w-[4.75rem] absolute top-144 left-2 h-auto w-30 -rotate-9 object-contain opacity-70 drop-shadow-[0_0.35rem_0.45rem_rgb(54_43_21/0.12)] max-[980px]:top-96 max-[980px]:left-1 max-[980px]:w-[5.5rem]"
			src={dolphinImage}
			alt=""
			loading="eager"
			fetchpriority="high"
			decoding="async"
		/>
		<Image
			class="hero-sketch hero-sketch-icecream max-nav:top-98 max-nav:left-24 max-nav:w-17 absolute top-144 left-48 h-auto w-26 rotate-7 object-contain opacity-70 drop-shadow-[0_0.35rem_0.45rem_rgb(54_43_21/0.12)] max-[980px]:top-98 max-[980px]:left-22 max-[980px]:w-[4.75rem]"
			src={icecreamImage}
			alt=""
			loading="eager"
			fetchpriority="high"
			decoding="async"
		/>
		<Image
			class="hero-sketch hero-sketch-penrose max-nav:hidden absolute top-192 left-20 h-auto w-22 rotate-12 object-contain opacity-70 drop-shadow-[0_0.35rem_0.45rem_rgb(54_43_21/0.12)] max-[980px]:top-140 max-[980px]:left-12 max-[980px]:w-16"
			src={penroseImage}
			alt=""
			loading="eager"
			fetchpriority="high"
			decoding="async"
		/>
	</div>
</div>
