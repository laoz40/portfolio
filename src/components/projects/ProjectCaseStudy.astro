---
import { Image } from "astro:assets";
import type { CaseStudySection } from "./caseStudySections";
import InlineGallery from "./inline/InlineGallery.svelte";
import InlineImage from "./inline/InlineImage.svelte";
import { getSectionRenderState } from "./projectCaseStudySectionState";
import Sidebar from "./Sidebar.svelte";
import SectionCarouselMedia from "./media/SectionCarouselMedia.svelte";
import SectionImageMedia from "./media/SectionImageMedia.astro";
import SectionLinkButtons from "./SectionLinkButtons.astro";
import SectionVideoMedia from "./media/SectionVideoMedia.astro";

const { sections, headingSelector = "h2" } = Astro.props as {
	sections: CaseStudySection[];
	headingSelector?: string;
};
---

<div
	class="project-shell mx-auto mt-4 grid w-full grid-cols-[13rem_minmax(0,1fr)] items-start gap-10 max-[1142px]:grid-cols-1">
	<Sidebar
		client:load
		headingSelector={headingSelector}
	/>
	<article
		class="project-content min-case-study:[--section-media-visual-max-width:36rem] [&_.inline-gallery\_\_caption]:font-body [&_.inline-gallery\_\_caption]:bg-paper max-case-study:[&_.inline-gallery\_\_tile]:max-w-none [&_.inline-image\_\_caption]:font-body [&_b]:font-body [&_b]:text-body [&_h1]:font-hand [&_h1]:text-hand-display-lg max-sm:[&_h1]:text-hand-display-md [&_h2]:font-hand [&_h2]:text-hand-title-sm [&_h2]:text-body [&_h3]:font-hand [&_h3]:text-hand-display-sm max-sm:[&_h3]:text-hand-display-sm [&_h4]:font-body [&_h4]:text-body [&_li]:font-body [&_li]:text-body [&_p]:font-body [&_p]:text-body [&_strong]:font-body [&_strong]:text-body [&_.project-badges_li]:bg-paper [&_.project-badges_li]:font-hand [&_.project-badges_li]:text-hand-body [&_.project-badges_li]:text-handwriting flex w-full flex-col gap-12 pl-4 [--section-copy-max-width:44rem] [--section-media-max-width:28rem] [--section-stack-max-width:44rem] [--text-measure:66ch] max-sm:px-0 [&_.inline-gallery]:mb-6 [&_.inline-gallery\_\_caption]:m-0 [&_.inline-gallery\_\_caption]:px-[0.85rem] [&_.inline-gallery\_\_caption]:pt-3 [&_.inline-gallery\_\_caption]:pb-[0.8rem] [&_.inline-gallery\_\_caption]:text-[0.9rem] [&_.inline-gallery\_\_caption]:leading-[1.4] [&_.inline-gallery\_\_frame]:[--paper-frame-border-color:var(--color-surface-paper)] [&_.inline-gallery\_\_frame]:[--paper-frame-shadow:0_0_0_0.18rem_rgb(31_30_25/0.08),var(--shadow-paper-medium)] [&_.inline-gallery\_\_image]:block [&_.inline-gallery\_\_image]:h-full [&_.inline-gallery\_\_image]:w-full [&_.inline-gallery\_\_image]:flex-1 [&_.inline-gallery\_\_image]:object-cover [&_.inline-gallery\_\_tile]:relative [&_.inline-gallery\_\_tile]:m-0 [&_.inline-gallery\_\_tile]:flex [&_.inline-gallery\_\_tile]:min-h-36 [&_.inline-gallery\_\_tile]:w-full [&_.inline-gallery\_\_tile]:translate-y-[var(--inline-gallery-shift,0px)] [&_.inline-gallery\_\_tile]:rotate-[var(--inline-gallery-tilt,0deg)] [&_.inline-gallery\_\_tile]:flex-col [&_.inline-gallery\_\_tile]:overflow-hidden [&_.inline-image]:relative [&_.inline-image]:[aspect-ratio:var(--inline-image-aspect-ratio)] [&_.inline-image]:rotate-[-0.35deg] [&_.inline-image]:overflow-hidden [&_.inline-image]:bg-[var(--color-accent-lime)] max-sm:[&_.inline-image]:rotate-0 [&_.inline-image-frame]:[--paper-frame-border-color:var(--color-surface-paper)] [&_.inline-image-frame]:[--paper-frame-shadow:0_0_0_0.18rem_rgb(31_30_25/0.08),var(--shadow-paper-medium)] max-sm:[&_.inline-image-frame::before]:rotate-[1.2deg] [&_.inline-image\_\_asset]:block [&_.inline-image\_\_asset]:h-full [&_.inline-image\_\_asset]:w-full [&_.inline-image\_\_asset]:object-cover [&_.inline-image\_\_caption]:mt-[0.6rem] [&_.inline-image\_\_caption]:mb-0 [&_.inline-image\_\_caption]:max-w-[var(--text-measure)] [&_.inline-image\_\_caption]:text-[0.9rem] [&_.inline-image\_\_caption]:leading-[1.4] [&_.project-badges]:m-0 [&_.project-badges]:mb-4 [&_.project-badges]:flex [&_.project-badges]:list-none [&_.project-badges]:flex-wrap [&_.project-badges]:gap-2 [&_.project-badges]:p-0 [&_.project-badges_li]:m-0 [&_.project-badges_li]:inline-block [&_.project-badges_li]:max-w-none [&_.project-badges_li]:border [&_.project-badges_li]:border-[var(--color-border-soft)] [&_.project-badges_li]:px-[0.65rem] [&_.project-badges_li]:py-[0.1rem] [&_.project-badges_li]:leading-[1.2] [&_.project-badges_li]:tracking-[0.02em] [&_b]:font-bold [&_h1]:m-0 [&_h1]:mb-4 [&_h1]:leading-[0.95] [&_h1]:font-bold [&_h1]:whitespace-nowrap max-sm:[&_h1]:mb-2 max-sm:[&_h1]:whitespace-normal [&_h2]:mt-8 [&_h2]:mb-4 [&_h2]:[scroll-margin-top:calc(var(--nav-offset)+1rem)] [&_h2]:leading-none [&_h2]:font-normal [&_h2]:tracking-[0.01em] [&_h3]:mb-4 [&_h3]:leading-[0.95] [&_h3]:font-bold [&_h3]:text-balance [&_h4]:mt-8 [&_h4]:mb-2 [&_h4]:text-base [&_h4]:leading-[var(--type-sans-leading-tight)] [&_h4]:font-bold [&_h4]:tracking-[0.01em] [&_li]:mb-2 [&_li]:max-w-[var(--text-measure)] [&_li]:text-base [&_li]:leading-[var(--type-sans-leading-relaxed)] [&_li]:font-light [&_li]:text-pretty [&_ol]:mb-4 [&_ol]:list-decimal [&_ol]:pl-5 [&_p]:mb-4 [&_p]:max-w-[var(--text-measure)] [&_p]:text-base [&_p]:leading-[var(--type-sans-leading-reading)] [&_p]:font-light [&_p]:text-pretty [&_strong]:font-bold [&_ul]:mb-4 [&_ul]:list-disc [&_ul]:pl-5"
		data-scrollspy-root>
		{
			sections.map((section) => {
				const SectionComponent = section.Component;
				const {
					variant,
					sectionClass,
					sectionProps,
					sectionLinks,
					linksAriaLabel,
					inlineGalleries,
					inlineImages,
					carouselItems,
					carouselImageFit,
					carouselAspectRatio,
					carouselBackground,
					mediaKind,
					imageMedia,
					videoMedia,
				} = getSectionRenderState(section);

				return (
					<section
						class:list={[
							"section max-case-study:w-[min(100%,var(--section-stack-max-width))] max-case-study:grid-cols-1 max-case-study:gap-4 mx-auto grid w-[min(100%,calc(var(--section-copy-max-width)+var(--section-media-column-width,var(--section-media-max-width))+3rem))] min-w-0 grid-cols-[minmax(0,var(--section-copy-max-width))_minmax(18rem,var(--section-media-column-width,var(--section-media-max-width)))] items-start justify-center gap-x-12 gap-y-8",
							`section--${variant}`,
							sectionClass,
							variant === "featured" &&
								"[&.section--featured_.section-media--embed]:min-h-0 [&.section--featured_.section-media-frame]:col-span-full [&.section--featured_.section-media-frame]:w-full [&.section--featured_.section-media-frame]:justify-self-center",
							variant === "carousel" &&
								"max-case-study:[&.section--carousel_.section-copy]:justify-self-stretch [&.section--carousel_.section-carousel]:static [&.section--carousel_.section-carousel]:col-span-full [&.section--carousel_.section-carousel-slide]:min-h-0 [&.section--carousel_.section-copy]:col-span-1 [&.section--carousel_.section-copy]:justify-self-start",
							sectionClass === "section--media-only" &&
								"[&.section--media-only_.section-copy]:hidden",
							sectionClass === "section-handwriting-list" &&
								"[&.section-handwriting-list_li]:font-hand [&.section-handwriting-list_li]:text-hand-label [&.section-handwriting-list_li]:mt-4 [&.section-handwriting-list_li]:leading-[1.15] [&.section-handwriting-list_li]:text-balance [&.section-handwriting-list_li]:text-inherit",
						]}>
						<div class="section-copy max-case-study:w-full max-case-study:justify-self-stretch w-[min(100%,var(--section-copy-max-width))] min-w-0 justify-self-center">
							<SectionComponent {...sectionProps} />
							{inlineGalleries.map((gallery) => (
								<InlineGallery
									client:load
									galleryId={gallery.id}>
									<template>
										<div class="inline-gallery grid grid-cols-[repeat(2,minmax(0,max-content))] justify-start gap-x-4 gap-y-[1.35rem] max-sm:grid-cols-1">
											{gallery.items.map((item) => (
												<div
													class="inline-gallery__frame taped-frame max-case-study:max-w-[min(100%,28rem)] relative w-full max-w-84 min-w-0 justify-self-start pt-[calc(var(--size-project-tape-height)*0.5)]"
													style="--tape-angle: calc(var(--inline-gallery-tilt, 0deg) + 1.2deg);">
													<figure class="inline-gallery__tile paper-frame">
														<Image
															class="inline-gallery__image"
															src={item.image}
															alt={item.alt}
															width={item.image.width}
															height={item.image.height}
															loading="lazy"
															decoding="async"
														/>
														{item.caption ? (
															<figcaption class="inline-gallery__caption">
																{item.caption}
															</figcaption>
														) : null}
													</figure>
												</div>
											))}
										</div>
									</template>
								</InlineGallery>
							))}
							{inlineImages.map((item) => (
								<InlineImage
									client:load
									imageId={item.id}>
									<template>
										<div
											class="inline-image-frame taped-frame relative mb-6 w-full max-w-[calc(var(--text-measure)*1.4)] pt-[calc(var(--size-project-tape-height)*0.5)]"
											style={`--inline-image-max-width: ${item.image.width}px; --inline-image-aspect-ratio: ${item.image.width} / ${item.image.height};`}>
											<div class="inline-image paper-frame">
												<img
													class="inline-image__asset"
													src={item.image.src}
													alt={item.alt}
													width={item.image.width}
													height={item.image.height}
													loading="lazy"
													decoding="async"
												/>
											</div>
											{item.caption ? <p class="inline-image__caption">{item.caption}</p> : null}
										</div>
									</template>
								</InlineImage>
							))}
							{sectionLinks.length > 0 ? (
								<SectionLinkButtons
									links={sectionLinks}
									ariaLabel={linksAriaLabel}
								/>
							) : null}
						</div>
						{mediaKind === "carousel" ? (
							<SectionCarouselMedia
								client:visible
								items={carouselItems}
								imageFit={carouselImageFit}
								aspectRatio={carouselAspectRatio}
								background={carouselBackground}
							/>
						) : null}
						{mediaKind === "video" && videoMedia ? (
							<SectionVideoMedia
								videoId={videoMedia.videoId}
								title={videoMedia.title}
							/>
						) : null}
						{mediaKind === "image" && imageMedia ? (
							<SectionImageMedia
								image={imageMedia.image}
								alt={imageMedia.alt}
								caption={imageMedia.caption}
							/>
						) : null}
					</section>
				);
			})
		}
	</article>
</div>

<style>
	.section:nth-of-type(odd) {
		--section-media-tilt: -0.4deg;
	}

	.section:nth-of-type(even) {
		--section-media-tilt: 0.4deg;
	}

	.project-content :global(.inline-gallery__frame:nth-child(4n + 1)) {
		--inline-gallery-tilt: -0.2deg;
		--inline-gallery-shift: -1px;
	}

	.project-content :global(.inline-gallery__frame:nth-child(4n + 2)) {
		--inline-gallery-tilt: -0.3deg;
		--inline-gallery-shift: 1px;
	}

	.project-content :global(.inline-gallery__frame:nth-child(4n + 3)) {
		--inline-gallery-tilt: 0.2deg;
		--inline-gallery-shift: -1px;
	}

	.project-content :global(.inline-gallery__frame:nth-child(4n + 4)) {
		--inline-gallery-tilt: -0.2deg;
		--inline-gallery-shift: 1px;
	}

	.project-content :global(.project-badges li:nth-child(3n + 1)) {
		transform: rotate(-0.9deg) translateY(-0.5px);
	}

	.project-content :global(.project-badges li:nth-child(3n + 2)) {
		transform: rotate(0.65deg) translateY(0.35px);
	}

	.project-content :global(.project-badges li:nth-child(3n + 3)) {
		transform: rotate(-0.45deg) translateY(0.2px);
	}
</style>
