---
const { videoId, title = "YouTube video" } = Astro.props as {
	videoId: string;
	title?: string;
};

const embedUrl = `https://www.youtube.com/embed/${videoId}`;
---

<div
	class="section-media-frame taped-frame max-case-study:min-h-56 w-full min-w-0 self-center pt-[calc(var(--size-project-tape-height)*0.5)] [--paper-frame-border-color:var(--color-surface-paper)] [--paper-frame-shadow:0_0_0_0.18rem_rgb(31_30_25/0.08),var(--shadow-paper-medium)] max-sm:min-h-36"
	style="--tape-angle: calc(var(--section-media-tilt, 0deg) + 1.2deg);">
	<div
		class="section-media paper-frame section-media--embed relative min-h-64 min-w-0 rotate-[var(--section-media-tilt,0deg)] max-sm:rotate-0">
		<iframe
			class="section-media-embed block h-full w-full border-0"
			src={embedUrl}
			title={title}
			loading="lazy"
			allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
			referrerpolicy="strict-origin-when-cross-origin"
			allowfullscreen
		></iframe>
	</div>
</div>

<style>
	.section-media--embed {
		aspect-ratio: 16 / 9;
		min-height: 0;
		overflow: hidden;
		transform: none;
	}
</style>
