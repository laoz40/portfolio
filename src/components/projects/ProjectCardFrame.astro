---
const { class: className } = Astro.props as { class?: string };
---

<div
	class:list={[
		"project-frame relative flex min-h-[35rem] w-full flex-col border-[0.18rem] border-[rgb(31_30_25/0.14)] bg-[rgb(255_253_246)] p-[0.9rem] shadow-[var(--shadow-paper-rest)] transition-[box-shadow,transform] duration-200 group-hover:shadow-[var(--shadow-paper-hover)] before:pointer-events-none before:absolute before:top-0 before:left-1/2 before:z-1 before:h-[var(--size-project-tape-height)] before:w-[var(--size-project-tape-width)] before:-translate-x-1/2 before:-translate-y-1/2 before:rotate-[1.2deg] before:bg-[var(--color-tape)] before:content-['']",
		className,
	]}>
	<slot />
</div>

<style>
	.project-frame--featured {
		transform: rotate(-0.35deg);
	}

	.project-frame--grid {
		transform: rotate(var(--preview-tilt, 0deg));
	}

	.group:hover .project-frame {
		transform: translateY(-0.25rem);
	}

	.group:hover .project-frame--featured {
		transform: translateY(-0.25rem) rotate(-0.35deg);
	}

	.group:hover .project-frame--grid {
		transform: translateY(-0.25rem) rotate(var(--preview-tilt, 0deg));
	}

	@media (max-width: 640px) {
		.project-frame--featured {
			min-height: auto;
			transform: none;
		}

		.project-frame--grid {
			transform: none;
		}

		.group:hover .project-frame--featured,
		.group:hover .project-frame--grid {
			transform: translateY(-0.25rem);
		}
	}

	@media (max-width: 900px) {
		.project-frame--grid {
			min-height: auto;
			padding: 0.95rem;
		}
	}

	@media (min-width: 1440px) {
		.project-frame--grid {
			min-height: 39rem;
		}
	}
</style>
