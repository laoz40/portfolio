---
type Layout = "featured" | "grid";

const { layout = "grid" } = Astro.props as { layout?: Layout };
---

<div
	class:list={[
		"project-frame relative flex min-h-[35rem] w-full flex-col border-[0.18rem] border-[rgb(31_30_25/0.14)] bg-[rgb(255_253_246)] p-[0.9rem] shadow-[var(--shadow-paper-rest)] transition-[box-shadow,transform] duration-200 group-hover:-translate-y-1 group-hover:shadow-[var(--shadow-paper-hover)] before:pointer-events-none before:absolute before:top-0 before:left-1/2 before:z-1 before:h-[var(--size-project-tape-height)] before:w-[var(--size-project-tape-width)] before:-translate-x-1/2 before:-translate-y-1/2 before:rotate-[1.2deg] before:bg-[var(--color-tape)] before:content-['']",
		layout === "featured" &&
			"-rotate-[0.35deg] group-hover:-rotate-[0.35deg] max-sm:min-h-auto max-sm:rotate-0 max-sm:group-hover:rotate-0",
		layout === "grid" &&
			"rotate-[var(--preview-tilt,0deg)] group-hover:rotate-[var(--preview-tilt,0deg)] max-[900px]:min-h-auto max-[900px]:p-[0.95rem] max-sm:rotate-0 max-sm:group-hover:rotate-0 min-[1440px]:min-h-[39rem]",
	]}>
	<slot />
</div>
