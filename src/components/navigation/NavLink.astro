---
import HighlightText from "../ui/HighlightText.astro";

const { href, variant = "yellow", selectable = false, target, rel, ...attributes } = Astro.props;
---

<a
	class="nav-link group inline-block no-underline"
	href={href}
	target={target}
	rel={rel}
	{...attributes}>
	<HighlightText
		class="nav-link-text font-hand text-hand-title-md px-3 py-3.5 leading-tight transition-transform duration-150 group-active:scale-95"
		variant={variant}
		selectable={selectable}
		style="--highlight-top: 0.4em; --highlight-bottom: 0.6em; --highlight-left: -0.04em; --highlight-right: -0.03em;">
		<slot />
	</HighlightText>
</a>
